# The brain: profiles the site, writes prompts, scores every answer. Required.
ANTHROPIC_API_KEY=

# Engines. Each one switches on when its key is present. `echolocate status` shows which are live.
GOOGLE_AI_API_KEY=        # Gemini (Google Search grounding on)   — alias: GEMINI_API_KEY
OPENAI_API_KEY=           # ChatGPT (Responses API, web_search tool on)
PERPLEXITY_API_KEY=       # Perplexity (Sonar)
# Claude as an engine reuses ANTHROPIC_API_KEY (web search on). ~$0.05-0.10/answer.
DATAFORSEO_LOGIN=         # Google AI Mode + AI Overview; also a fallback route for ChatGPT/Gemini/Perplexity
DATAFORSEO_PASSWORD=

# Optional — models
# ECHO_MODEL=claude-sonnet-5-5                 # one-off onboarding: profile, topics, prompts
# ECHO_ANALYSIS_MODEL=claude-haiku-4-5 # daily scoring of every answer
# ECHO_GEMINI_MODEL=gemini-flash-latest
# ECHO_OPENAI_MODEL=gpt-5
# ECHO_CLAUDE_MODEL=claude-sonnet-5-5
# ECHO_PERPLEXITY_MODEL=sonar

# Optional — defaults for newly onboarded brands
# ECHO_ENGINES=chatgpt,gemini,perplexity,google_ai_mode,google_ai_overview   # default: every engine with a key, minus claude
# ECHO_COUNTRY=us
# ECHO_LANGUAGE=en

# Optional — throughput
# ECHO_ENGINE_CONCURRENCY=6     # engine calls in flight
# ECHO_PROMPT_CONCURRENCY=4     # scoring calls in flight

# Optional — storage (default ./data/echolocate.db)
# ECHO_DB=/absolute/path/echolocate.db

# Optional — REST API / dashboard (`echolocate serve`)
# ECHO_API_TOKEN=change-me
# PORT=8787

# Optional — daily email via Resend
# RESEND_API_KEY=
# ECHO_EMAIL_FROM=echolocate <reports@yourdomain.com>
# ECHO_EMAIL_TO=you@yourdomain.com
